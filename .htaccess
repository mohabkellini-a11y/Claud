# EverSafe Fire Protection
# Apache / LiteSpeed config for eversafe-fire.com

# ----------------------------------------------------------
# 1. Force HTTPS and the non-www host
# Sends http:// and www. traffic to https://eversafe-fire.com
# This keeps one canonical address for search engines.
# ----------------------------------------------------------
RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://eversafe-fire.com%{REQUEST_URI} [R=301,L]

# ----------------------------------------------------------
# 2. Caching
# Images and fonts cache for a long time.
# HTML and the crawler files never cache, so new deploys
# show up right away.
# ----------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png            "access plus 1 year"
  ExpiresByType image/jpeg           "access plus 1 year"
  ExpiresByType image/svg+xml        "access plus 1 year"
  ExpiresByType font/woff2           "access plus 1 year"
  ExpiresByType text/css             "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html            "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Always re-check HTML on each visit
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Keep robots.txt, sitemap.xml and llms.txt fresh
  <FilesMatch "\.(txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------
# 3. Default page
# ----------------------------------------------------------
DirectoryIndex index.html
